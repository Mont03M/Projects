<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ChessSquare="clr-namespace:ChessGame.Utilities">

    <Style TargetType="ChessSquare:ToggleChessSquare" x:Key="toggleChessSquare">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ChessSquare:ToggleChessSquare">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Black"
                        BorderThickness="0.8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                   
                    <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        
    </Style>
    
</ResourceDictionary>