<UserControl x:Class="ChessGame.Views.MainChessGameUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChessGame.Views"
             mc:Ignorable="d"
             MinWidth="1500" MinHeight="1000">
    <Grid>
        <Grid Grid.ColumnSpan="1">

            <Grid.Background>
                <ImageBrush ImageSource="/assets/displayElements/background.jpg"/>
            </Grid.Background>

            <TextBlock Text="Chess Game" Style="{StaticResource title}" VerticalAlignment="Top" 
            Foreground="Brown" FontSize="85" Margin="1,15,1,1"/>


            <Border x:Name="ButtonBorder" BorderThickness="5" CornerRadius="10,10,10,10" 
                  BorderBrush="AntiqueWhite" Background="DimGray" Opacity="0.8"
                  Width="400"
                  VerticalAlignment="Center">
                <StackPanel Width="350" Height="205" VerticalAlignment="Top" Margin="0,40,0,0">
                    <Button Content="Play Match" Style="{StaticResource circleButton}" Height="50" Width="200" Margin="15" Command="{Binding MainView.mainViewModel.NavigateGameOptionsCommand}"/>
                    <Button Content="Settings" Style="{StaticResource circleButton}" Height="50" Width="200" Margin="15" Command="{Binding MainView.mainViewModel.NavigateSettingsCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
