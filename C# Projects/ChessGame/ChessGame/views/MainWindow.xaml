<Window x:Class="ChessGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessGame"
        xmlns:vm="clr-namespace:ChessGame.ViewModels"
        xmlns:tool="clr-namespace:ChessGame.Utilities"
        mc:Ignorable="d"
        Title="Chess Game" 
        Height="1000" Width="1500"
        MinWidth="1500" MinHeight="1000"
        Closing="Window_Closing">
    <!-- ContentControl (Switching views)-->
    <Grid>
        <ContentControl x:Name="SwitchControl" Content="{Binding Navigation.CurrentView, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</Window>
